<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.1</version>
        <relativePath/>
    </parent>

    <groupId>com.rxt</groupId>
    <artifactId>rxt-backend</artifactId>
    <version>1.0.0</version>
    <name>rxt-backend</name>
    <description>基于数字经济的农产品融销一体平台 - 后端服务</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <obs.sdk.version>3.26.6</obs.sdk.version>
    </properties>

    <dependencies>
        <!-- Web / REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            持久层：Spring Boot 4 必须使用 mybatis-plus-spring-boot4-starter（3.5.15 起提供）。
            旧的 mybatis-plus-spring-boot3-starter 在 Boot 4 下自动配置类路径已变更，启动会失败。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- 分页插件依赖（3.5.9 起 JSqlParser 被拆为独立模块，分页必须显式引入） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JWT 认证 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            密码加密：只引 spring-security-crypto 一个模块，用它的 BCryptPasswordEncoder。
            版本由 spring-boot-starter-parent 的 BOM 统一管理，不需要写 version。

            切勿改成 spring-boot-starter-security：那个 starter 会把整条 Spring Security
            自动配置链带进来，接管全部请求并统统返回 401；本项目的鉴权是
            LoginInterceptor + UserContext 手写实现的，两套机制会互相打架。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            华为云 OBS 对象存储 SDK：商品图片 / 知识配图 / 用户头像由后端转存对象存储并返回可访问 URL
            （《概要设计说明书》§2 技术方案、§8.4 安全设计；接口 POST /api/common/upload）。

            ① 用 -bundle 变体而不是 esdk-obs-java：
               bundle 是官方 shaded 包，已把 okhttp / okio / jackson / log4j 重定位进 com.obs.* 命名空间。
               thin 版会往应用 classpath 里塞 okhttp3 + jackson-databind 2.x，而 Spring Boot 4 已切到
               Jackson 3（tools.jackson），两套 Jackson 并存极易在序列化环节出难查的问题。
            ② 必须排除 bundle 自带的 log4j：
               Spring Boot 默认日志链里已经有 log4j-api + log4j-to-slf4j（把 log4j2 API 桥接到 SLF4J/Logback）。
               SDK 探测日志实现时是先 Class.forName("org.apache.logging.log4j.LogManager")，
               命中就用它的 Log4j2 分支 —— 因为 log4j-api 一定在，这一支必然命中，
               于是 SDK 的日志会经由 log4j-api 汇入 log4j-to-slf4j → Logback，
               从而套用 application.yml 里配的 [traceId] 格式。
               若再让 bundle 带进 log4j-core，log4j2 会另起一套日志上下文，反而把上面这条链路打断。

               「排除掉依赖声明里的 log4j-core 会不会运行时 NoClassDefFoundError？」
               已核对 SDK 3.26.6 字节码：SDK 里唯一用到 log4j-core 的类 com.obs.services.Log4j2Configurator
               完全通过反射访问（Class.forName + invoke，常量池无硬引用），
               且其异常表捕获了 ClassNotFoundException 并带兜底 catch；
               日志实现探测处（LoggerBuilder$GetLoggerHolder）也同时捕获
               ClassNotFoundException 与 NoClassDefFoundError 后才降级。
               故排除后最坏情况只是「跳过 log4j2 的额外配置」，不会中断上传功能。
        -->
        <dependency>
            <groupId>com.huaweicloud</groupId>
            <artifactId>esdk-obs-java-bundle</artifactId>
            <version>${obs.sdk.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>rxt-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
