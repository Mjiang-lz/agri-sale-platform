# ---------------------- Java / Maven ----------------------
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---------------------- Node / 前端 ----------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------- IDE ----------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
*.swp
*.swo

# ---------------------- macOS ----------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# ---------------------- 日志 / 临时文件 ----------------------
logs/
*.log
*.tmp
*.bak

# ---------------------- 本地上传文件 ----------------------
# rxt.obs.local-dir 的默认值：OBS 未启用时后端把上传的图片写到 backend/uploads。
# 那是运行时数据（且随时会变大），不入库。
uploads/

# ---------------------- 敏感配置 ----------------------
# 本地数据源、对象存储密钥等不应入库
application-local.yml
application-prod.yml
*.keystore
*.jks

# ---------------------- 数据库导出 / 转储 ----------------------
# 结构变更一律改 db/schema.sql 或 db/migrations/ 下的脚本，
# 不要提交从 Navicat 等工具导出的数据库文件（含真实数据、密码哈希）。
*.dump
*.ibd
dump-*.sql
*-dump.sql
*_backup.sql
*_bak.sql
data-backup*/
