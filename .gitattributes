# 统一换行符：仓库内一律以 LF 存储，检出时按平台自动转换。
# 目的：Mac 与 Windows 混合开发时，避免因 CRLF/LF 差异产生"整文件 diff"。

* text=auto eol=lf

# 明确按文本处理（防止 Git 误判为二进制）
*.java       text
*.sql        text
*.xml        text
*.yml        text
*.yaml       text
*.json       text
*.md         text
*.txt        text
*.js         text
*.ts         text
*.vue        text
*.css        text
*.html       text
*.properties text

# Windows 脚本必须保留 CRLF，否则 cmd 可能执行异常
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件，禁止任何换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text
*.jar  binary
*.war  binary
*.zip  binary
*.gz   binary
*.xlsx binary
*.xls  binary
*.docx binary
*.doc  binary
*.pdf  binary
