# 融销通 · 部署环境变量模板
#
# 用法：
#   cp .env.example .env
#   把下面两个空值填上，然后 docker compose up -d --build
#
# ⚠️ docker compose 会自动读取和 docker-compose.yml **同目录**的 .env，
#    不需要 --env-file。而 .env 已在 .gitignore 里，**不要手动 git add 它**。
#    本文件（.env.example）才是要入库的那份，只放变量名和生成命令，不放真实密钥。

# ---------------------------------------------------------------------------
# 数据库 root 密码
# ---------------------------------------------------------------------------
# compose 里的 MySQL **没有对宿主机映射端口**，只有同一 compose 网络内的后端能连，
# 所以随便一个随机串即可，不用记。改成别的值只会影响"首次初始化"那一次
# （mysql 卷建好之后，改这里不会改已有库的密码，反而会连不上）。
# 生成：openssl rand -base64 24
RXT_DB_PASSWORD=

# ---------------------------------------------------------------------------
# ★ JWT 签名密钥 —— 必填
# ---------------------------------------------------------------------------
# 没设置时 compose **会直接拒绝启动**并打印这条提示，这是有意为之：
# 少了它，代码会退化成用空密钥签名，症状是"容器起来了、一登录就 500"。
#
# 生成：openssl rand -base64 48
#
# 它的严重性：拿到这个密钥的人可以自己签发任意用户、任意角色的合法 token，
# 不需要知道任何人的密码。所以它一旦进过版本库就必须重新生成
# （只是删掉文件没用，历史里还在），重新生成后所有人的登录态会失效。
RXT_JWT_SECRET=

# ---------------------------------------------------------------------------
# 对外端口（默认 8088）
# ---------------------------------------------------------------------------
# 云服务器上必须在**安全组**里放行同一个端口，否则本机 curl 通、外面连不上。
RXT_HTTP_PORT=8088

# ---------------------------------------------------------------------------
# 接口文档（Swagger），默认关
# ---------------------------------------------------------------------------
# 只在"需要给别人看接口清单"时临时设成 true，看完改回 false 并重启。
RXT_API_DOCS_ENABLED=false

# ---------------------------------------------------------------------------
# 对象存储（可选，默认不启用）
# ---------------------------------------------------------------------------
# 整套部署**默认不用 OBS**：只有一台服务器、所有人指向同一份，
# 图片写在后端的 uploads 卷里，上传完别人立刻就能看到 —— 本来就不需要同步。
# 不开还能省掉最麻烦的一件事：把 AK/SK 分发给每个队友。
#
# 什么时候才需要开：
#   · 要把图片和数据库分开部署（比如后面接 CDN、或者数据库换成了云数据库）
#   · 有多套环境要共用同一批图片
#   这时把下面三行取消注释，并在华为云 OBS 控制台确认桶是**公共读**
#   （否则浏览器拿到的图片地址会 403，页面上一片破图）。
#   OBS 模式下后端返回的是完整 https 绝对地址，不再走 /api/files。
#
# RXT_OBS_ENABLED=true
# RXT_OBS_ACCESS_KEY=
# RXT_OBS_SECRET_KEY=
